PORT=3000
APP_BASE_URL=http://localhost:3000
AZURE_SQL_SERVER=datateamserverdev.database.windows.net
AZURE_SQL_DATABASE=komunikacja
# Optional when running with a user-assigned managed identity.
AZURE_CLIENT_ID=
# Comma-separated emails allowed to import/replace shared GTFS schedules.
ADMIN_EMAILS=
# Optional Google OAuth credentials. Set both to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Free email: any SMTP account. For Gmail use SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# your address as SMTP_USER and SMTP_FROM, and an App Password as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SendGrid (paid alternative): use a restricted Mail Send API key and a verified sender address.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Local development only: set to true to print email codes to the console instead of
# sending them through SendGrid. Ignored when NODE_ENV=production.
AUTH_EMAIL_CONSOLE=
# Use a persistent random secret (at least 32 characters) to HMAC email codes.
AUTH_CODE_PEPPER=
# Optional: folder of the flight-tracker project. An administrator then starts runs from Admin > Pobieranie lotów.
# Needs Node 22.15+, npm install and "npx playwright install chromium" in that folder, and a desktop session for Wizz Air.
FLIGHT_TRACKER_DIR=
# Routes for the "all routes" run, as ORIGIN:DEST,DEST;ORIGIN:DEST
FLIGHT_ROUTES=RZE:STN,LTN,EDI,DUB,ALC,BGY;KRK:STN,DUB,BCN,BGY;KTW:LTN,EIN,BCN,BGY
# Optional: any other flight-tracker database or JSON fare file. Checked hourly; only the next 14 days are stored.
# Reading a .db file needs Node 22.13 or newer. Import once by hand with: npm run flights:import -- <file>
FLIGHT_FARES_FILE=

# How often the background job refreshes PKP train delays, in minutes (default 20).
PKP_REFRESH_MINUTES=

ash_live_in6LY5XLVrnUQmPERmogZDSoM8EVATSP

# Fuel price for comparing the car with the train (zł per litre). Without these the official maximum price from 10.11.2026 is used.
FUEL_PRICE_PB95=
FUEL_PRICE_ON=
FUEL_PRICE_DATE=
FUEL_PRICE_SOURCE=
