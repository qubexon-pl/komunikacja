PORT=3000
APP_BASE_URL=http://localhost:3000
AZURE_SQL_SERVER=datateamserverdev.database.windows.net
AZURE_SQL_DATABASE=komunikacja
# Optional when running with a user-assigned managed identity.
AZURE_CLIENT_ID=
# Comma-separated emails allowed to import/replace shared GTFS schedules.
ADMIN_EMAILS=
# Optional Google OAuth credentials. Set both to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SendGrid: use a restricted Mail Send API key and a verified sender address.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Local development only: set to true to print email codes to the console instead of
# sending them through SendGrid. Ignored when NODE_ENV=production.
AUTH_EMAIL_CONSOLE=
# Use a persistent random secret (at least 32 characters) to HMAC email codes.
AUTH_CODE_PEPPER=
